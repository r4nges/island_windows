{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Island",
  "version": "0.3.0",
  "identifier": "dev.r4nges.island",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Island",
        "url": "index.html",
        "width": 720,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "msix/AppxManifest.xml": "AppxManifest.xml",
      "msix/Assets/StoreLogo.png": "Assets/StoreLogo.png",
      "msix/Assets/Square44x44Logo.png": "Assets/Square44x44Logo.png",
      "msix/Assets/Square150x150Logo.png": "Assets/Square150x150Logo.png"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "Island"
}